# Safe paper trading configuration
# This config makes live trading impossible.
# Copy to .env and fill in broker credentials for paper mode only.
#
# With this config:
#   - TRADING_MODE=paper: no real orders submitted to broker
#   - ENABLE_LIVE_TRADING=false: config validator blocks live mode startup
#   - BROKER_DRY_RUN is not set: paper fill simulation is used
#   - All live-mode compliance gates are left blank (will fail if live mode attempted)
#
# To go live, you must explicitly:
#   1. Change TRADING_MODE=live
#   2. Change ENABLE_LIVE_TRADING=true
#   3. Fill in ALL compliance gates (STRATEGY_ID, BROKER_APPROVAL_DATE, etc.)
#   4. Complete docs/RELEASE_CHECKLIST.md in full

TRADING_MODE=paper
ENABLE_LIVE_TRADING=false
CAPITAL_INR=500000

# ── Broker credentials (needed for WebSocket data even in paper mode) ─────────
SHOONYA_USER=YOUR_USER_ID
SHOONYA_PASSWORD=YOUR_PASSWORD
SHOONYA_TOTP_SECRET=YOUR_TOTP_SECRET
SHOONYA_VENDOR_CODE=YOUR_VENDOR_CODE
SHOONYA_API_SECRET=YOUR_API_SECRET
SHOONYA_IMEI=YOUR_IMEI

# ── Data feed (Stage 1: Shoonya throttled WebSocket) ─────────────────────────
DATA_FEED=shoonya
USE_MICROSTRUCTURE=false
BAR_TYPE=time
BAR_INTERVAL_MINUTES=15

# ── NSE session timing ────────────────────────────────────────────────────────
SESSION_START_HHMM=09:15
SESSION_END_HHMM=15:30
NO_NEW_TRADES_AFTER_HHMM=15:15
FORCE_CLOSE_HHMM=15:15
SKIP_FIRST_BAR=true

# ── Strategy (leave blank — not required for paper mode) ─────────────────────
STRATEGY_ID=
BROKER_APPROVAL_DATE=

# ── Live-mode compliance gates (all blank = live trading blocked) ─────────────
APPROVED_STATIC_IP=
OTR_TRACKING_ENABLED=false
AUDIT_LOG_PATH=
KILL_SWITCH_TESTED=false
APPROVED_MODEL_VERSION=

# ── Risk limits ───────────────────────────────────────────────────────────────
MAX_DAILY_LOSS_PCT=0.02
MAX_POSITION_PCT=0.05
MAX_GROSS_EXPOSURE_PCT=0.20
MAX_DRAWDOWN_PCT=0.10

# ── Order execution ───────────────────────────────────────────────────────────
MAX_ORDERS_PER_SECOND=8
STALE_ORDER_TIMEOUT_SEC=20
MAX_PRICE_DRIFT_BPS=30
MAX_ORDER_MODIFICATIONS=5
PRODUCT_TYPE=MIS
EXCHANGE_SEGMENT=NSE

# ── EMA cross signal parameters ───────────────────────────────────────────────
EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=21
ATR_PERIOD=14
ATR_STOP_MULTIPLIER=1.5
MIN_BARS_BEFORE_SIGNAL=21

# ── ZeroMQ IPC ports ─────────────────────────────────────────────────────────
ZMQ_TICK_PUB_PORT=5555
ZMQ_BAR_PUB_PORT=5558
ZMQ_FEATURE_PUB_PORT=5556
ZMQ_ML_SIGNAL_PUSH_PORT=5557
ZMQ_ALERT_PUSH_PORT=5560

# ── QuestDB (local docker) ────────────────────────────────────────────────────
QUESTDB_HOST=localhost
QUESTDB_ILP_PORT=9000
QUESTDB_PG_PORT=8812
QUESTDB_PG_USER=admin
QUESTDB_PG_PASSWORD=quest_CHANGE_THIS

# ── Alerts (optional but strongly recommended) ────────────────────────────────
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

# ── System ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
SYMBOLS=RELIANCE,TCS,HDFCBANK,INFY,ICICIBANK
